# Private office profile. Fill these values on the main PC; do not send passwords in chat.
ERP_OFFICE_MODE=true
ERP_OFFICE_BIND=127.0.0.1
PORT=3000
# Replace loopback with this PC's private LAN IPv4 after checking office access.
DATABASE_URL=postgresql://erp:REPLACE_DATABASE_PASSWORD@127.0.0.1:5432/dongyang_erp
ERP_ADMIN_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD
ERP_SESSION_SECRET=REPLACE_WITH_SEPARATE_RANDOM_SESSION_KEY
ERP_COOKIE_SECURE=false
# Configure the actual writable NAS backup share only after its path is confirmed.
ERP_NAS_BACKUP_DIR=
