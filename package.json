{
  "name": "dongyang-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:check": "tsx scripts/check-db.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "access:local": "node scripts/prepare-local-access.mjs",
    "db:check-chart": "tsx scripts/check-chart-transition.ts",
    "deploy:prepare": "node scripts/prepare-deployment.mjs",
    "start:cloud": "node scripts/start-cloud.mjs",
    "db:backup": "node --env-file-if-exists=.env scripts/database-transfer.mjs backup",
    "db:restore": "node --env-file-if-exists=.env scripts/database-transfer.mjs restore",
    "db:check-backup": "node scripts/check-backup.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^7.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module"
}
