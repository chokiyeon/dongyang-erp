# 개발 전용 예시입니다. 운영 환경에는 별도 비밀값을 설정하세요.
POSTGRES_DB=dongyang_erp
POSTGRES_USER=dongyang
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://dongyang:local-development-only@127.0.0.1:5432/dongyang_erp?schema=public

# 관리자 비밀번호 12자 이상, 별도의 무작위 세션 키 32자 이상 필요
# 실제 비밀값은 저장소에 기록하지 마세요. 로컬은 npm run access:local로 준비합니다.
# ERP_ADMIN_PASSWORD=
# ERP_SESSION_SECRET=
# 로컬 HTTP만 false. HTTPS 운영은 true(기본값)
# ERP_COOKIE_SECURE=false
